# =====================================================================
# ENTERPRISE AI DECISION PATH AUDITOR - ENVIRONMENT CONFIGURATION
# =====================================================================

# Application Configuration
APP_NAME="PS-7.1 Enterprise AI Decision Path Auditor"
APP_ENV="production"
DEBUG=False
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"

# Database Configuration (PostgreSQL / SQLite fallback)
# PostgreSQL Async Driver format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="sqlite+aiosqlite:///./audit_ledger.db"
SYNC_DATABASE_URL="sqlite:///./audit_ledger.db"

# Groq LLM API Configuration (Optional: fallback generator active if key omitted)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Security & Secrets Management
SECRET_KEY="production-super-secret-key-change-in-prod"
API_KEY_ENABLED=False
API_KEY="secret-audit-api-key"

# Cloud & AWS Configuration
AWS_REGION="us-east-1"
