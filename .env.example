APP_NAME="PS-7.1 Decision Path Auditor"
APP_ENV="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Database Configuration
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/decision_path_audit"
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/decision_path_audit"

# Groq LLM API Configuration
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# Security & API Keys
API_KEY_ENABLED=False
API_KEY="secret-audit-api-key"
